# Environment Variables (Example)

# ============================================
# NextAuth Configuration (REQUIRED)
# ============================================
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET="your-random-secret-key-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# ============================================
# Google OAuth (REQUIRED for Google login)
# ============================================
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ============================================
# Microsoft Entra ID OAuth (REQUIRED for Microsoft login)
# ============================================
AUTH_MICROSOFT_ENTRA_ID_ID="your-application-client-id"
AUTH_MICROSOFT_ENTRA_ID_SECRET="your-client-secret-value"
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="common"

# ============================================
# User Access Control (OPTIONAL)
# ============================================
# Comma-separated list of allowed email addresses
# Leave empty to allow all authenticated users
# ALLOWED_EMAILS="user1@example.com,user2@example.com"

# ============================================
# Database Configuration (for production)
# ============================================
# Example: Vercel Postgres
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# Example: MongoDB Atlas
# MONGODB_URI=

# Example: Supabase
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Note: This app now uses Google Drive and OneDrive for data storage
# No additional database configuration needed
