# Environment Variables (Example)

# For production deployment with a database, add your database credentials here
# Uncomment and fill in based on your database choice

# Example: Vercel Postgres
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# Example: MongoDB Atlas
# MONGODB_URI=

# Example: Supabase
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# No environment variables needed for local file-based storage
